---
import Layout from '../layouts/Layout.astro';
import SubNav from '../components/SubNav.astro';

// Array de videos: cuando tengas los links de YouTube, simplemente coloca el link o ID en youtubeUrl
const videos = [
  {
    id: '1',
    sessionNumber: '01',
    title: 'CRAZY ROOM LIVE REC — SESSION #01',
    artist: 'LINEUP POR CONFIRMAR',
    genre: 'RAW / INDUSTRIAL TECHNO',
    location: 'VALPARAÍSO',
    date: 'TEMPORADA 2026',
    youtubeUrl: '', // Coloca aquí el link de YouTube cuando esté disponible
  },
  {
    id: '2',
    sessionNumber: '02',
    title: 'CRAZY ROOM LIVE REC — SESSION #02',
    artist: 'LINEUP POR CONFIRMAR',
    genre: 'HYPNOTIC / HARD GROOVE',
    location: 'VALPARAÍSO',
    date: 'TEMPORADA 2026',
    youtubeUrl: '',
  },
  {
    id: '3',
    sessionNumber: '03',
    title: 'CRAZY ROOM LIVE REC — SESSION #03',
    artist: 'LINEUP POR CONFIRMAR',
    genre: 'MODULAR LIVE ACT',
    location: 'VALPARAÍSO',
    date: 'TEMPORADA 2026',
    youtubeUrl: '',
  },
  {
    id: '4',
    sessionNumber: '04',
    title: 'CRAZY ROOM LIVE REC — SESSION #04',
    artist: 'LINEUP POR CONFIRMAR',
    genre: 'DARK TECHNO / EXPERIMENTAL',
    location: 'VALPARAÍSO',
    date: 'TEMPORADA 2026',
    youtubeUrl: '',
  },
];

// Helper para extraer el embed URL de cualquier link o ID de YouTube
function getEmbedUrl(input: string): string {
  if (!input) return '';
  const match = input.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  if (match && match[1]) {
    return `https://www.youtube-nocookie.com/embed/${match[1]}`;
  }
  if (input.trim().length === 11) {
    return `https://www.youtube-nocookie.com/embed/${input.trim()}`;
  }
  return input;
}
---

<Layout
  title="CRAZY ROOM — VIDEOS"
  description="Registro audiovisual y grabaciones en vivo de CRAZY ROOM Valparaíso. Sets completos y cultura electrónica de club."
>
  <!-- ════════════════════════════════════════ -->
  <!--  HERO                                    -->
  <!-- ════════════════════════════════════════ -->
  <header class="hero">
    <!-- Foto de fondo: z-index 10000 → encima del grain (9999) -->
    <img
      src="/hero-videos.jpg"
      alt=""
      class="hero-bg-img"
      aria-hidden="true"
      draggable="false"
    />
    <!-- Overlay oscuro: encima de la foto, debajo del contenido -->
    <div class="hero-overlay"></div>

    <!-- Contenido: logo encima de todo -->
    <div class="hero-inner">
      <p class="hero-eyebrow">VALPARAÍSO</p>
      <h1 class="hero-title">
        <a href="/" class="logo-link" title="Volver al inicio">
          <img
            src="/logo.png"
            alt="CRAZY ROOM — REC LIVE SESSION"
            class="hero-logo"
            draggable="false"
          />
        </a>
      </h1>
      <!-- SubNav bar justo debajo del logo -->
      <SubNav currentPath="/videos" />
    </div>
    <div class="hero-line"></div>
  </header>

  <!-- ════════════════════════════════════════ -->
  <!--  VIDEOS SECTION                          -->
  <!-- ════════════════════════════════════════ -->
  <section class="videos-section">
    <div class="container">
      <div class="section-intro-card">
        <span class="eyebrow-tag">// ARCHIVO AUDIOVISUAL</span>
        <h2 class="section-label">SESIONES EN VIVO</h2>
        <p class="section-lead">
          Registro directo desde el club. Sets completos y live acts producidos con estándar de transmisión
          y estética cruda para dar visibilidad a la escena electrónica porteña.
        </p>
        <div class="channel-banner">
          <span class="channel-status">CANAL OFICIAL EN YOUTUBE</span>
          <a
            href="https://www.youtube.com/@CRAZYROOMCL"
            target="_blank"
            rel="noopener noreferrer"
            class="channel-link"
          >
            <span>SUSCRÍBETE A @CRAZYROOMCL</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Grilla de Videos -->
      <div class="video-grid">
        {videos.map((item) => {
          const embedUrl = getEmbedUrl(item.youtubeUrl);
          const hasVideo = Boolean(embedUrl);

          return (
            <article class="video-card">
              <div class="video-media-wrap">
                {hasVideo ? (
                  <iframe
                    src={embedUrl}
                    title={item.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    class="video-iframe"
                    loading="lazy"
                  ></iframe>
                ) : (
                  <div class="video-placeholder">
                    <div class="placeholder-overlay">
                      <div class="rec-badge">
                        <span class="rec-dot"></span>
                        <span>REC LIVE SESSION #{item.sessionNumber}</span>
                      </div>
                      <div class="play-icon-box">
                        <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
                          <polygon points="6,4 20,12 6,20" />
                        </svg>
                      </div>
                      <span class="placeholder-notice">PRÓXIMAMENTE EN YOUTUBE</span>
                    </div>
                  </div>
                )}
              </div>

              <div class="video-info">
                <div class="video-meta">
                  <span class="video-tag">#{item.sessionNumber}</span>
                  <span class="video-genre">{item.genre}</span>
                  <span class="video-date">{item.date}</span>
                </div>
                <h3 class="video-title">{item.title}</h3>
                <p class="video-artist">ARTISTA: <strong>{item.artist}</strong></p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ -->
  <!--  FOOTER                                  -->
  <!-- ════════════════════════════════════════ -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <p class="footer-brand">CRAZY ROOM</p>
        <nav class="footer-links">
          <a
            href="https://www.instagram.com/crazyroom.cl/?hl=es"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/>
            </svg>
            Instagram
          </a>
          <a
            href="https://www.youtube.com/@CRAZYROOMCL"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408L6.4 5.209z"/>
            </svg>
            YouTube
          </a>
        </nav>
        <p class="footer-copy">© 2024 CRAZY ROOM — Valparaíso</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* ── Layout containers ── */
  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  /* ── HERO ── */
  .hero {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    z-index: 10000;
    pointer-events: none;
    user-select: none;
    opacity: 0.85;
    filter: contrast(115%) brightness(0.85);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0) 100%);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 10001;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(5,5,5,0.2) 0%,
      rgba(5,5,5,0.25) 50%,
      rgba(5,5,5,0.85) 85%,
      rgba(5,5,5,1) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 10002;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-eyebrow {
    font-size: 1rem;
    letter-spacing: 0.4em;
    color: #e0e0e0;
    font-weight: 700;
    text-transform: uppercase;
    font-family: 'Barlow Condensed', sans-serif;
    text-shadow: 0 2px 10px rgba(0,0,0,0.95);
  }

  .hero-title {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    user-select: none;
  }

  .logo-link {
    display: block;
    text-decoration: none;
  }

  .hero-logo {
    width: 100%;
    max-width: 680px;
    height: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 4px 20px rgba(0,0,0,0.9)) drop-shadow(0 0 2px rgba(255,255,255,0.15));
    -webkit-user-drag: none;
  }

  .hero-line {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 4rem;
    background: linear-gradient(to bottom, transparent, var(--border));
  }

  /* ── VIDEOS SECTION ── */
  .videos-section {
    padding: 3rem 0 7rem;
    position: relative;
    background: #050505;
  }

  .section-intro-card {
    position: relative;
    z-index: 10000;
    background: #0c0c0c;
    border: 1px solid #222222;
    border-top: 2px solid #ffffff;
    padding: 3rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.95), 0 0 1px rgba(255, 255, 255, 0.08);
    margin-bottom: 3.5rem;
    box-sizing: border-box;
  }

  .eyebrow-tag {
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    color: var(--gray-dim);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-label {
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: 0.05em;
    color: #ffffff;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.05;
    margin-bottom: 0.75rem;
    font-family: 'Barlow Condensed', sans-serif;
  }

  .section-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: #cccccc;
    line-height: 1.6;
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    margin: 0 0 2rem 0;
  }

  .channel-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    background: #000000;
    border: 1px solid #333333;
    padding: 1rem 1.5rem;
  }

  .channel-status {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--off-white);
  }

  .channel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    color: #000000;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    padding: 0.5rem 1rem;
    transition: background 0.2s, color 0.2s;
  }

  .channel-link:hover {
    background: var(--off-white);
  }

  /* ── Video Grid ── */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    position: relative;
    z-index: 10000;
  }

  .video-card {
    background: #0c0c0c;
    border: 1px solid #222222;
    border-top: 1px solid #ffffff;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
    transition: border-color 0.2s, transform 0.2s;
  }

  .video-card:hover {
    border-color: #555555;
    border-top-color: #ffffff;
  }

  .video-media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000000;
    border-bottom: 1px solid #222222;
    overflow: hidden;
  }

  .video-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Placeholder estético para videos */
  .video-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: 
      radial-gradient(circle at center, rgba(30, 30, 30, 0.9) 0%, rgba(0, 0, 0, 1) 85%),
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 20px 20px, 20px 20px;
    position: relative;
  }

  .placeholder-overlay {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    text-align: center;
    padding: 1.5rem;
  }

  .rec-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid #444444;
    padding: 0.3rem 0.65rem;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: #e0e0e0;
  }

  .rec-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 6px #ffffff;
  }

  .play-icon-box {
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ffffff;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.6);
    transition: transform 0.2s, background 0.2s;
  }

  .video-card:hover .play-icon-box {
    transform: scale(1.08);
    background: #ffffff;
    color: #000000;
  }

  .placeholder-notice {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--gray-dim);
    text-transform: uppercase;
  }

  /* Info */
  .video-info {
    padding: 1.75rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .video-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.75rem;
    color: var(--gray-dim);
  }

  .video-tag {
    color: #ffffff;
    font-weight: 700;
    background: #1a1a1a;
    padding: 0.15rem 0.4rem;
    border: 1px solid #333333;
  }

  .video-genre {
    color: #cccccc;
    letter-spacing: 0.08em;
  }

  .video-date {
    margin-left: auto;
  }

  .video-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #ffffff;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0.2rem 0 0.1rem;
  }

  .video-artist {
    font-family: 'Barlow', sans-serif;
    font-size: 0.95rem;
    color: var(--off-white);
    margin: 0;
  }

  .video-artist strong {
    color: #ffffff;
    font-weight: 600;
  }

  /* ── FOOTER ── */
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-brand {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 0.3em;
    color: var(--white);
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--gray-dim);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--white);
  }

  .footer-copy {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--gray-dim);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .video-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .section-intro-card {
      padding: 2rem 1.5rem;
      margin-bottom: 2.5rem;
    }

    .hero {
      padding: 3rem 1.25rem 2.5rem;
      min-height: 80svh;
    }

    .hero-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.25em;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .footer-links {
      gap: 1.25rem;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 1rem;
    }

    .videos-section {
      padding: 2rem 0 4rem;
    }

    .channel-banner {
      flex-direction: column;
      align-items: flex-start;
    }

    .channel-link {
      width: 100%;
      justify-content: space-between;
      box-sizing: border-box;
    }

    .video-info {
      padding: 1.25rem 1rem 1.5rem;
    }

    .video-title {
      font-size: 1.15rem;
    }
  }
</style>
