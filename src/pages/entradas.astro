---
import Layout from '../layouts/Layout.astro';
import SubNav from '../components/SubNav.astro';
---

<Layout
  title="CRAZY ROOM — ENTRADAS"
  description="Acceso anticipado y entradas para CRAZY ROOM Valparaíso. Sé el primero en saber cuándo las entradas estén disponibles."
>
  <!-- ════════════════════════════════════════ -->
  <!--  HERO                                    -->
  <!-- ════════════════════════════════════════ -->
  <header class="hero">
    <!-- Foto de fondo: z-index 10000 → encima del grain (9999) -->
    <img
      src="/hero-entradas.jpg"
      alt=""
      class="hero-bg-img"
      aria-hidden="true"
      draggable="false"
    />
    <!-- Overlay oscuro: encima de la foto, debajo del contenido -->
    <div class="hero-overlay"></div>

    <!-- Contenido: logo encima de todo -->
    <div class="hero-inner">
      <p class="hero-eyebrow">VALPARAÍSO</p>
      <h1 class="hero-title">
        <a href="/" class="logo-link" title="Volver al inicio">
          <img
            src="/logo.png"
            alt="CRAZY ROOM — REC LIVE SESSION"
            class="hero-logo"
            draggable="false"
          />
        </a>
      </h1>
      <!-- SubNav bar justo debajo del logo -->
      <SubNav currentPath="/entradas" />
    </div>
    <div class="hero-line"></div>
  </header>

  <!-- ════════════════════════════════════════ -->
  <!--  ENTRADAS SECTION                        -->
  <!-- ════════════════════════════════════════ -->
  <section class="entradas-section">
    <div class="container">
      <div class="entradas-card">
        <!-- Encabezado -->
        <div class="card-header">
          <span class="eyebrow-tag">// ACCESO ANTICIPADO</span>
          <h2 class="section-label">ENTRADAS & NOTIFICACIONES</h2>
          <p class="section-lead">
            Sé el primero en enterarte cuando las entradas salgan a la venta.
          </p>
        </div>

        <div class="card-body">
          <div class="info-text">
            <p>
              El aforo para las sesiones en vivo de <strong>CRAZY ROOM</strong> es estrictamente limitado
              para mantener la intimidad, la presión acústica y la energía cruda del club.
            </p>
            <p>
              Las entradas se liberarán por tandas exclusivas. Déjanos tu correo electrónico y recibirás
              un aviso antes de la apertura general al público para que asegures tu lugar.
            </p>
            <div class="status-badge">
              <span class="pulse-dot"></span>
              <span class="status-label">ESTADO: CONVOCATORIA EN CURSO · VENTA PRÓXIMAMENTE</span>
            </div>
          </div>

          <!-- Formulario Newsletter / Pre-registro -->
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="newsletter-form"
            id="tickets-form"
          >
            <input type="hidden" name="access_key" value="457207df-439a-4914-aad3-b62b131ac715" />
            <input type="hidden" name="subject" value="Nuevo registro para Entradas — CRAZY ROOM" />
            <input type="hidden" name="from_name" value="CRAZY ROOM Entradas" />
            <input type="checkbox" name="botcheck" style="display:none" />

            <div class="form-field">
              <label for="ticket-email">
                TU CORREO ELECTRÓNICO <span class="req">*</span>
              </label>
              <input
                type="email"
                id="ticket-email"
                name="email"
                required
                placeholder="ejemplo@correo.com"
                autocomplete="email"
              />
            </div>

            <div class="check-field">
              <label class="check-label">
                <input type="checkbox" name="consentimiento" required checked />
                <span class="checkmark"></span>
                <span class="check-text">
                  Deseo recibir el aviso prioritario por correo electrónico cuando se liberen las entradas.
                </span>
              </label>
            </div>

            <button type="submit" class="submit-btn">
              <span class="btn-text">QUIERO SER EL PRIMERO EN SABER</span>
              <span class="btn-arrow">→</span>
            </button>

            <!-- Mensaje de respuesta -->
            <div id="ticket-result" class="form-result" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ -->
  <!--  FOOTER                                  -->
  <!-- ════════════════════════════════════════ -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <p class="footer-brand">CRAZY ROOM</p>
        <nav class="footer-links">
          <a
            href="https://www.instagram.com/crazyroom.cl/?hl=es"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/>
            </svg>
            Instagram
          </a>
          <a
            href="https://www.youtube.com/@CRAZYROOMCL"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408L6.4 5.209z"/>
            </svg>
            YouTube
          </a>
        </nav>
        <p class="footer-copy">© 2024 CRAZY ROOM — Valparaíso</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* ── Layout containers ── */
  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  /* ── HERO ── */
  .hero {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    z-index: 10000;
    pointer-events: none;
    user-select: none;
    opacity: 0.85;
    filter: contrast(115%) brightness(0.85);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0) 100%);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 10001;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(5,5,5,0.2) 0%,
      rgba(5,5,5,0.25) 50%,
      rgba(5,5,5,0.85) 85%,
      rgba(5,5,5,1) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 10002;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-eyebrow {
    font-size: 1rem;
    letter-spacing: 0.4em;
    color: #e0e0e0;
    font-weight: 700;
    text-transform: uppercase;
    font-family: 'Barlow Condensed', sans-serif;
    text-shadow: 0 2px 10px rgba(0,0,0,0.95);
  }

  .hero-title {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    user-select: none;
  }

  .logo-link {
    display: block;
    text-decoration: none;
  }

  .hero-logo {
    width: 100%;
    max-width: 680px;
    height: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 4px 20px rgba(0,0,0,0.9)) drop-shadow(0 0 2px rgba(255,255,255,0.15));
    -webkit-user-drag: none;
  }

  .hero-line {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 4rem;
    background: linear-gradient(to bottom, transparent, var(--border));
  }

  /* ── ENTRADAS SECTION ── */
  .entradas-section {
    padding: 3rem 0 7rem;
    position: relative;
    background: #050505;
  }

  .entradas-card {
    position: relative;
    z-index: 10000;
    background: #0c0c0c;
    border: 1px solid #222222;
    border-top: 2px solid #ffffff;
    padding: 3.5rem 3rem 4rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.95), 0 0 1px rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
    max-width: 100%;
  }

  .card-header {
    border-bottom: 1px solid #222222;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow-tag {
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    color: var(--gray-dim);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-label {
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: 0.05em;
    color: #ffffff;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.05;
    margin-bottom: 0.75rem;
    font-family: 'Barlow Condensed', sans-serif;
  }

  .section-lead {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: #cccccc;
    line-height: 1.5;
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    margin: 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .info-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-text p {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--off-white);
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    margin: 0;
  }

  .info-text strong {
    color: #ffffff;
    font-weight: 600;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    background: #000000;
    border: 1px solid #333333;
    width: fit-content;
    margin-top: 0.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 10px #ffffff;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.1); }
    100% { opacity: 0.4; transform: scale(0.9); }
  }

  .status-label {
    font-size: 0.8rem;
    font-family: 'Courier New', Courier, monospace;
    letter-spacing: 0.15em;
    color: #cccccc;
    text-transform: uppercase;
  }

  /* ── Newsletter Form ── */
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: #050505;
    border: 1px solid #222222;
    padding: 2.25rem;
    box-sizing: border-box;
    max-width: 100%;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .form-field label {
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    color: #e0e0e0;
    text-transform: uppercase;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
  }

  .req {
    color: var(--white);
  }

  .newsletter-form input[type="email"] {
    position: relative;
    z-index: 10000;
    background: #000000;
    border: 1px solid #444444;
    border-radius: 0;
    color: var(--white);
    font-family: inherit;
    font-size: 1.05rem;
    padding: 0.9rem 1.2rem;
    width: 100%;
    box-sizing: border-box;
    max-width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    -webkit-text-fill-color: var(--white);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.95);
  }

  .newsletter-form input[type="email"]::placeholder {
    color: #555555;
    -webkit-text-fill-color: #555555;
  }

  .newsletter-form input[type="email"]:focus {
    border-color: var(--white);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.95), 0 0 0 1px var(--white);
  }

  /* Checkbox */
  .check-field {
    margin-top: 0.25rem;
  }

  .check-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--gray-dim);
    line-height: 1.5;
    font-family: 'Barlow', sans-serif;
  }

  .check-label input[type="checkbox"] {
    display: none;
  }

  .checkmark {
    position: relative;
    z-index: 10000;
    display: inline-block;
    width: 16px;
    height: 16px;
    min-width: 16px;
    border: 1px solid #444444;
    background: #000000;
    margin-top: 2px;
    transition: border-color 0.2s;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.95);
  }

  .check-label input[type="checkbox"]:checked + .checkmark {
    border-color: var(--white);
  }

  .check-label input[type="checkbox"]:checked + .checkmark::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 1px;
    width: 5px;
    height: 9px;
    border: 1px solid var(--white);
    border-top: 0;
    border-left: 0;
    transform: rotate(45deg);
  }

  /* Submit button */
  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--white);
    color: var(--black);
    border: none;
    padding: 1.25rem 1.75rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    margin-top: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    max-width: 100%;
  }

  .submit-btn:hover {
    background: var(--off-white);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-arrow {
    font-size: 1.35rem;
    font-family: inherit;
  }

  /* Feedback */
  .form-result {
    font-size: 1rem;
    letter-spacing: 0.08em;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    padding: 0.75rem;
    min-height: 1.5rem;
    display: none;
  }

  .form-result.success {
    display: block;
    color: var(--white);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--white);
  }

  .form-result.error {
    display: block;
    color: #ff5555;
    background: rgba(255, 0, 0, 0.05);
    border: 1px solid #ff4444;
  }

  /* ── FOOTER ── */
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-brand {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 0.3em;
    color: var(--white);
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--gray-dim);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--white);
  }

  .footer-copy {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--gray-dim);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .entradas-card {
      padding: 2.25rem 1.5rem 2.5rem;
    }

    .newsletter-form {
      padding: 1.5rem 1.25rem;
    }

    .hero {
      padding: 3rem 1.25rem 2.5rem;
      min-height: 80svh;
    }

    .hero-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.25em;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .footer-links {
      gap: 1.25rem;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 380px) {
    .container {
      padding: 0 1rem;
    }

    .entradas-section {
      padding: 2rem 0 4rem;
    }

    .submit-btn {
      padding: 1rem 1.25rem;
      font-size: 0.95rem;
    }
  }
</style>

<script>
  const form = document.getElementById('tickets-form') as HTMLFormElement | null;
  const resultDiv = document.getElementById('ticket-result');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement | null;
      if (!emailInput || !emailInput.value.trim()) return;

      const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement | null;
      const btnText = submitBtn?.querySelector('.btn-text');

      if (submitBtn && btnText) {
        submitBtn.disabled = true;
        btnText.textContent = 'REGISTRANDO...';
      }

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          if (resultDiv) {
            resultDiv.textContent = '→ ¡Listo! Tu correo fue registrado. Te avisaremos de forma prioritaria cuando salgan las entradas.';
            resultDiv.className = 'form-result success';
          }
          form.reset();
        } else {
          throw new Error(data.message || 'Error al registrar.');
        }
      } catch (err) {
        if (resultDiv) {
          resultDiv.textContent = '→ Hubo un error al registrar tu correo. Por favor inténtalo de nuevo o escríbenos por Instagram.';
          resultDiv.className = 'form-result error';
        }
      } finally {
        if (submitBtn && btnText) {
          submitBtn.disabled = false;
          btnText.textContent = 'QUIERO SER EL PRIMERO EN SABER';
        }
      }
    });
  }
</script>
