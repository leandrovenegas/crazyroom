<script>
  // ── Interacción Galería: Click en miniatura cambia la foto principal ──
  const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const newSrc = btn.getAttribute('data-src');
      if (mainImg && newSrc && mainImg.src !== newSrc) {
        mainImg.style.opacity = '0.3';
        setTimeout(() => {
          mainImg.src = newSrc;
          mainImg.style.opacity = '1';
        }, 150);

        thumbBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      }
    });
  });

  // ── Interacción Tallas: Selección actualiza texto y enlace dinámico de WhatsApp ──
  let currentSize = 'M';
  const sizeBtns = document.querySelectorAll<HTMLButtonElement>('.size-btn');
  const selectedSizeText = document.getElementById('selected-size-text');
  const whatsappBuyBtn = document.getElementById('whatsapp-buy-btn') as HTMLAnchorElement | null;

  function updateWhatsAppLink(size: string) {
    if (whatsappBuyBtn) {
      const message = `Hola CRAZY ROOM, quiero comprar la polera oficial CRAZY ROOM 001 en talla ${size}`;
      whatsappBuyBtn.href = `https://wa.me/?text=${encodeURIComponent(message)}`;
    }
  }

  sizeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const size = btn.getAttribute('data-size');
      if (size) {
        currentSize = size;
        sizeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        if (selectedSizeText) {
          selectedSizeText.textContent = `TALLA SELECCIONADA: ${currentSize}`;
        }

        updateWhatsAppLink(currentSize);
      }
    });
  });
</script>
